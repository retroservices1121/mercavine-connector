# Copy to .env.local. The server runs in mock payment mode until STRIPE_SECRET_KEY starts with sk_.

BRAND_NAME=Mercavine
BRAND_HANDLE=mercavine
BRAND_DOMAIN=mercavine.com
BRAND_LEGAL_NAME=Mercavine
# Intended domain. Not purchased. Leave WEBSITE_URL empty until it is.
WEBSITE_URL=
PUBLIC_BASE_URL=http://127.0.0.1:4317

CONTACT_NAME=Joe Perez
CONTACT_ROLE=CEO
CONTACT_EMAIL=mercavine-outreach@mail.grokbot.com

# 300 basis points = 3% of each seller charge (merchandise + shipping + tax).
# Collected as Stripe application_fee_amount. Not added to the shopper total.
# A $100.00 charge produces a $3.00 fee.
PLATFORM_FEE_BPS=300
DEFAULT_TAX_BPS=750

MERCAVINE_DB_PATH=data/mercavine.sqlite
MERCAVINE_ALLOW_DEV_STEP_UP=true
MERCAVINE_DEV_TOOLS=true
# Set true to require RFC 9421 signatures on every bot call. Signatures are verified whenever they are sent.
MERCAVINE_REQUIRE_SIGNATURES=false

# Leave unset for mock direct charges. A key starting with sk_ switches on Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional test PaymentMethod. Defaults to pm_card_visa when Stripe mode is on.
STRIPE_TEST_PAYMENT_METHOD=
# Override a seeded seller's connected account, for example:
# STRIPE_ACCOUNT_SEL_HINGE=acct_...

# Shopify Catalog UCP. Off unless you have access. In-bot checkout stays off until Shopify grants complete_checkout.
SHOPIFY_CATALOG_ENABLED=false
SHOPIFY_CATALOG_MCP_URL=https://catalog.shopify.com/api/ucp/mcp
SHOPIFY_IN_BOT_CHECKOUT=false
SHOPIFY_UCP_AGENT_PROFILE=
# Saved catalog id from the Dev Dashboard (org 241084154). Leave unset until promoted placements are enabled for that catalog.
# When set, Global Catalog search_catalog sends catalog.catalog_id. Variant urls are returned exactly, including shclid and shcgid.
SHOPIFY_CATALOG_ID=

# Shop MCP catalog (https://mcp.shop.com/). On unless set to false. No API key required.
# Results are not cached. Merchant images stay on their source URLs.
SHOP_CATALOG_ENABLED=true
SHOP_MCP_URL=https://mcp.shop.com/
# Optional Dev Dashboard client credentials for higher Shop catalog limits. Not a result cache.
SHOP_DEV_CLIENT_ID=
SHOP_DEV_CLIENT_SECRET=

# Shop Pay. Off unless true. Mock when enabled without a buyer token or SHOP_ACCESS_TOKEN.
# SHOP_PAY_MODE=mock forces mock. SHOP_PAY_MODE=live still falls back to mock until a token exists.
# The 3% platform fee does not apply to Shop Pay orders.
SHOP_PAY_ENABLED=false
SHOP_PAY_MODE=
SHOP_ACCESS_TOKEN=

PASSKEY_RP_ID=
PASSKEY_ORIGIN=

# Amazon Multi-Channel Fulfillment. Off unless true. Mock when enabled without live credentials.
# AMAZON_MCF_MODE=live stays mock until LWA client id, client secret, and application id are all set.
# Checkout and the 3% fee stay on Mercavine. Do not scrape or order on amazon.com.
# Live SP-API calls also need AWS SigV4, which this server does not sign. See docs/amazon-mcf.md.
AMAZON_MCF_ENABLED=false
AMAZON_MCF_MODE=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_SP_APP_ID=
# Draft apps use version=beta on the Seller Central consent URL. Set false after Amazon approves the app.
AMAZON_SP_APP_DRAFT=true
AMAZON_SP_API_ENDPOINT=https://sandbox.sellingpartnerapi-na.amazon.com
AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_SELLER_CENTRAL_AUTHORIZE=https://sellercentral.amazon.com/apps/authorize/consent
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER

# Outbound email (verification + password reset). Without RESEND_API_KEY, dev/test
# use an in-memory outbox and production logs a warning and does NOT deliver mail.
RESEND_API_KEY=
MAIL_FROM=Mercavine <no-reply@mercavine.com>
MAIL_REPLY_TO=privacy@mercavine.com
# Base URL used in emailed links (defaults to https://BRAND_DOMAIN)
MAIL_LINK_BASE_URL=
